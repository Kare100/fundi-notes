# Copy this file to `.env` (same folder) and edit. Never commit `.env`.
# Every value below is a placeholder. The app runs with no keys at all in demo mode.

# ---------------------------------------------------------------- General
APP_ENV=development            # development | production (production refuses weak/empty passwords)
TIMEZONE=Africa/Nairobi        # used to decide what "today" means for new reports
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- Authentication
# One shared manager login (HTTP Basic). See README "Authentication boundary".
AUTH_ENABLED=true
AUTH_USERNAME=manager
AUTH_PASSWORD=change-me-please

# ---------------------------------------------------------------- Storage
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_AUDIO_SECONDS=600

# delete_after_processing : audio is deleted as soon as processing finishes (default, most private)
# keep_days               : audio is kept for AUDIO_RETENTION_DAYS, then purged
AUDIO_RETENTION=delete_after_processing
AUDIO_RETENTION_DAYS=7

# ---------------------------------------------------------------- Speech to text
# mock   : DEMO MODE. No audio is transcribed. Use the built in sample transcripts.
# openai : sends the AUDIO FILE to OpenAI's transcription API.
TRANSCRIPTION_PROVIDER=mock
OPENAI_API_KEY=your-openai-key-here
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Leave blank to auto detect. Examples: en, sw
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_PROMPT=Field service voice note from Kenya. The speaker may mix English, Swahili and Sheng.
# Below this average confidence the transcript is flagged as uncertain (0 to 1)
TRANSCRIPTION_MIN_CONFIDENCE=0.6

# ---------------------------------------------------------------- Extraction (LLM)
# mock      : DEMO MODE. Returns pre-written extractions for the sample transcripts and a very
#             limited heuristic for anything else. Not a real AI model.
# anthropic : sends the TRANSCRIPT TEXT to Anthropic's API.
# openai    : sends the TRANSCRIPT TEXT to OpenAI's API.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_LLM_MODEL=your-openai-chat-model-here

# Replace emails and phone numbers in the transcript with placeholders BEFORE it is sent to the LLM.
REDACT_CONTACT_DETAILS=true

# ---------------------------------------------------------------- Report checklist
CHECKLIST_PATH=./config/checklist.json
